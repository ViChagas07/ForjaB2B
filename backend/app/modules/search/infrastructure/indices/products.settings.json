{
  "number_of_shards": 1,
  "number_of_replicas": 0,
  "analysis": {
    "filter": {
      "pt_stop": {"type": "stop", "stopwords": "_portuguese_"},
      "pt_stemmer": {"type": "stemmer", "language": "portuguese"},
      "en_stop": {"type": "stop", "stopwords": "_english_"},
      "en_stemmer": {"type": "stemmer", "language": "english"},
      "es_stop": {"type": "stop", "stopwords": "_spanish_"},
      "es_stemmer": {"type": "stemmer", "language": "spanish"},
      "ar_stop": {"type": "stop", "stopwords": "_arabic_"},
      "ar_stemmer": {"type": "stemmer", "language": "arabic"},
      "ascii_folding": {"type": "asciifolding"},
      "edge_ngram_2_15": {"type": "edge_ngram", "min_gram": 2, "max_gram": 15}
    },
    "normalizer": {
      "lowercase_normalizer": {
        "type": "custom",
        "filter": ["lowercase", "ascii_folding"]
      }
    },
    "analyzer": {
      "pt_text": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "ascii_folding", "pt_stop", "pt_stemmer"]
      },
      "en_text": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "ascii_folding", "en_stop", "en_stemmer"]
      },
      "es_text": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "ascii_folding", "es_stop", "es_stemmer"]
      },
      "ar_text": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["arabic_normalization", "lowercase", "ar_stop", "ar_stemmer"]
      },
      "autocomplete_index": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "ascii_folding", "edge_ngram_2_15"]
      },
      "autocomplete_search": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "ascii_folding"]
      }
    }
  }
}
