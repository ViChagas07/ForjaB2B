# -----------------------------------------------------------------------------
# Forja B2B — Frontend (Next.js)
# -----------------------------------------------------------------------------
# Somente variaveis PUBLICAS podem usar o prefixo NEXT_PUBLIC_*.
# Nunca coloque aqui: DATABASE_URL, DATABASE_ADMIN_URL, senhas de PostgreSQL,
# API secrets, chaves privadas ou qualquer segredo de backend.

# Base URL da API (contrato /api/v1 definido pelo backend). Usada apenas no
# lado cliente (browser); em server components o valor vem de server-side.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL pública do site (canonical, sitemap, robots, Open Graph, hreflang,
# llms.txt). Em produção deve apontar para o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (fluxo tradicional de redirect para o backend/provider).
# OPCIONAL: quando ausente, o botão "Continuar com Google" fica oculto.
# NÃO é GIS (Google Identity Services); aponta para o endpoint OAuth do backend.
NEXT_PUBLIC_OAUTH_GOOGLE_URL=
