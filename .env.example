# -----------------------------------------------------------------------------
# Forja B2B - Configuração de Ambiente Local (Desenvolvimento)
# -----------------------------------------------------------------------------

# Aplicação
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# PostgreSQL - Separacao de credenciais
#
# BOOTSTRAP: superusuario efemero usado apenas no initdb do cluster (init scripts).
#   NUNCA e injetado no backend/worker (ver docker-compose.yml).
# ADMIN: role restrita (NOSUPERUSER, NOBYPASSRLS) para migracoes/DDL e operacao DBA.
# APP: role de runtime da aplicacao (DML, sujeita a RLS).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forja_db
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=forja_bootstrap_secret_dev
POSTGRES_ADMIN_USER=forja_admin
POSTGRES_ADMIN_PASSWORD=forja_admin_secret_dev
POSTGRES_APP_USER=forja_app
POSTGRES_APP_PASSWORD=forja_app_secret_dev

# SQLAlchemy URLs
# DATABASE_URL (app) e a unica URL de banco injetada no backend/worker.
# DATABASE_ADMIN_URL existe apenas para operadores/CI executarem migracoes;
# o docker-compose NAO a expoe aos containers de aplicacao.
DATABASE_URL=postgresql+asyncpg://forja_app:forja_app_secret_dev@postgres:5432/forja_db
DATABASE_ADMIN_URL=postgresql+asyncpg://forja_admin:forja_admin_secret_dev@postgres:5432/forja_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Mailpit (SMTP e Web UI)
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Elasticsearch (busca lexical; Fase 2)
# Seguranca LIGADA (xpack.security) com autenticacao por senha. Em dev, HTTP
# sem TLS e aceito APENAS na rede interna do Docker (a porta e publicada so em
# 127.0.0.1); TLS e obrigatorio em producao (Fase 6). ELASTICSEARCH_ENABLED
# permite desligar a integracao (a aplicacao sobe em modo degradado).
# NUNCA e fonte de verdade: preco/estoque permanecem no PostgreSQL.
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=forja_es_dev_password
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=forja_products
# Versao do indice versionado (<alias>_vN). O CLI aceita --version N para
# reconstruir uma versao nova; mantenha alinhado ao mapping em
# backend/app/modules/search/infrastructure/indices/.
ELASTICSEARCH_INDEX_VERSION=2
ELASTICSEARCH_INDEX_REPLICAS=0
# Timeouts/retries SEPARADOS (Fase 8A): busca interativa curta e SEM retries
# (cai no fallback rapido); indexacao/reindex/reconcile longa e com retries.
ELASTICSEARCH_SEARCH_TIMEOUT_SECONDS=2
ELASTICSEARCH_SEARCH_MAX_RETRIES=0
ELASTICSEARCH_INDEX_TIMEOUT_SECONDS=30
ELASTICSEARCH_INDEX_MAX_RETRIES=3
ELASTICSEARCH_BULK_BATCH_SIZE=500
ELASTICSEARCH_ENABLED=true
# TLS (producao): verificacao de certificado SEMPRE ativa; aponte a CA do cluster.
# Em dev (HTTP na rede interna do Docker) nao ha TLS, entao os valores sao ignorados.
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_CA_CERTS=
SEARCH_OUTBOX_MAX_ATTEMPTS=5
# 0 desliga o agendador no processo; em producao use o Cron/CLI ou ligue.
RECONCILE_INTERVAL_SECONDS=0
RECONCILE_JITTER_SECONDS=20
RECONCILE_TIMEOUT_SECONDS=300
SEARCH_METRICS_INTERVAL_SECONDS=30
SEARCH_DEFAULT_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=100
SEARCH_MAX_QUERY_LENGTH=100
SEARCH_MAX_DEEP_PAGINATION=5000
SEARCH_AUTOCOMPLETE_MIN_CHARS=2
SEARCH_AUTOCOMPLETE_MAX_SUGGESTIONS=10
# Circuit breaker do caminho lexical (Fase 8A): apos N falhas consecutivas o
# Elasticsearch e ignorado por T segundos (fallback direto), retomando sozinho.
SEARCH_CIRCUIT_BREAKER_FAILURES=3
SEARCH_CIRCUIT_BREAKER_COOLDOWN_SECONDS=15
# Tolerancia de divergencia de contagem na reindexacao (Fase 8A). Zero por
# padrao: o alias so e trocado se o novo indice bater com o PostgreSQL.
SEARCH_REINDEX_COUNT_TOLERANCE=0

# Busca semantica (Fase 5). Requer a imagem pgvector, a dependencia de runtime
# (onnxruntime + tokenizers) e o modelo baixado no build. Deixe desabilitado
# enquanto essa verificacao nao for concluida (ver docs/STATUS.md).
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL_PATH=/models/multilingual-e5-small
EMBEDDING_ONNX_FILENAME=model_O4.onnx
EMBEDDING_TOKENIZER_FILENAME=tokenizer.json
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CANDIDATE_LIMIT=50
EMBEDDING_RRF_K=60
EMBEDDING_QUERY_TIMEOUT_SECONDS=2.0

# OpenTelemetry e Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=forja-backend
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Segurança e Criptografia (Valores de Dev)
SECRET_KEY=dev_secret_key_change_in_production_min_32_bytes_long_value
PEPPER=dev_pepper_secret_for_cpf_hmac_2026
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# JWT (sessoes de acesso) - opcionais, defaults: HS256 / 30min / 7d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Authorization Code Flow tradicional, redirect). OPCIONAL:
# quando ausentes, os endpoints /api/v1/auth/google retornam 503 e o botao
# "Continuar com Google" fica oculto no frontend. O client_secret so existe no
# backend (nunca no frontend nem no repositorio).
# GOOGLE_REDIRECT_URI = callback registrado no Google Cloud (aponta para
#   /api/v1/auth/google/callback).
# GOOGLE_OAUTH_FRONTEND_REDIRECT = pagina de callback do frontend
#   (ex.: https://forja-b2b.vercel.app/pt-BR/auth/google/callback); recebe
#   apenas o exchange code de uso unico, nunca tokens. NUNCA use o caminho da
#   API (/api/v1/auth/google/callback): isso cria loop de redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_FRONTEND_REDIRECT=

# Frontend
# Destino SERVER-SIDE dos rewrites `/api/v1` e `/static` (nunca vai ao bundle).
# No Compose, o frontend alcanca o backend pelo nome do servico.
BACKEND_URL=http://backend:8000
PORT=3000

# -----------------------------------------------------------------------------
# Pagamentos (Fase 10) e Notificacoes (Fase 11) - Valores de Dev
# -----------------------------------------------------------------------------
# Desconto PIX simulado (fracao: 0.05 = 5%). Calculado no backend.
PIX_DISCOUNT_RATE=0.05
# Segredo HMAC que autentica o webhook do provedor de pagamento (canal
# sistema-a-sistema). Em producao DEVE ser injetado via secrets.
PAYMENT_WEBHOOK_SECRET=dev_payment_webhook_secret_change_in_production
# Rotacao sem janela de falha: o segredo anterior continua aceito ate todos os
# produtores atualizarem. Deixe vazio quando nao houver rotacao em andamento.
PAYMENT_WEBHOOK_SECRET_PREVIOUS=
# Limite do corpo de webhooks (bytes) e tolerancia do timestamp anti-replay.
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# Stripe Checkout (cartao). Vazio = cartao desabilitado (apenas PIX/BOLETO).
# STRIPE_SECRET_KEY: chave secreta da API (sk_test_... / sk_live_...).
# STRIPE_WEBHOOK_SECRET: segredo de assinatura do endpoint de webhook
#   (whsec_...), obtido em Stripe Dashboard > Developers > Webhooks.
# O webhook a cadastrar no Stripe e:
#   https://<api-host>/api/v1/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=
# Idempotencia de mutacoes criticas: TTL da resposta concluida (24 h) e da
# reserva em andamento (60 s, para destravar apos crash).
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_IN_PROGRESS_TTL_SECONDS=60
# Base publica do frontend usada nos redirects de sucesso/cancelamento do Stripe.
FRONTEND_BASE_URL=http://localhost:3000
# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por virgula.
# SEMPRE explicitas (sem '*'): em producao use o dominio real do frontend, por
# exemplo CORS_ORIGINS=https://app.forja.example. Nao inclua caminho nem barra final.
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
# Credenciais CORS (cookies/TLS client cert). O frontend usa Bearer token, entao
# o default e false. Se mudar para true, NUNCA use origem curinga.
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECONDS=600

# Rate limiting (Redis + fallback local). Limites por classe em token bucket:
# capacidade (burst) e reposicao por minuto. Ajuste conforme carga real.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=5
RATE_LIMIT_AUTH_REFILL_PER_MINUTE=10
# OAuth (start + callback + exchange) tem balde proprio: uma tentativa usa 3
# requisicoes e o limite de login (5) bloqueava duas tentativas legitimas.
RATE_LIMIT_OAUTH_CAPACITY=30
RATE_LIMIT_OAUTH_REFILL_PER_MINUTE=120
RATE_LIMIT_REGISTRATION_CAPACITY=3
RATE_LIMIT_REGISTRATION_REFILL_PER_MINUTE=5
RATE_LIMIT_SEARCH_CAPACITY=30
RATE_LIMIT_SEARCH_REFILL_PER_MINUTE=120
# Balde PROPRIO do dropdown de sugestoes (/search/suggest), mais folgado que o
# da busca: digitar no autocomplete nao pode esgotar o balde da pagina de
# resultados. Limite por IP (anônimos) ou por usuário (autenticados).
RATE_LIMIT_SUGGEST_CAPACITY=40
RATE_LIMIT_SUGGEST_REFILL_PER_MINUTE=180
RATE_LIMIT_ADMIN_WRITE_CAPACITY=20
RATE_LIMIT_ADMIN_WRITE_REFILL_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_CAPACITY=60
RATE_LIMIT_AUTHENTICATED_REFILL_PER_MINUTE=240
RATE_LIMIT_PUBLIC_READ_CAPACITY=120
RATE_LIMIT_PUBLIC_READ_REFILL_PER_MINUTE=600
RATE_LIMIT_WEBHOOK_CAPACITY=120
RATE_LIMIT_WEBHOOK_REFILL_PER_MINUTE=300
# Endpoints de IA (chat): classe propria de rate limit (por IP/usuario),
# somada ao orcamento diario de tokens (AI_DAILY_TOKEN_BUDGET). 429 com
# Retry-After quando estourar. A rota sera mapeada junto dos endpoints (FASE 3).
RATE_LIMIT_AI_CAPACITY=20
RATE_LIMIT_AI_REFILL_PER_MINUTE=60
# Proxies confiaveis entre internet e app: local = 0; Render direto = 1;
# Vercel na frente do Render = valide a cadeia X-Forwarded-For (normalmente 2).
# Com 0, X-Forwarded-For e ignorado e vale o IP da conexao.
TRUSTED_PROXY_COUNT=0
# Bloqueio progressivo de login por conta+IP (janela e backoff exponencial).
LOGIN_FAILURE_THRESHOLD=3
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_FAILURE_BASE_BACKOFF_SECONDS=30
LOGIN_FAILURE_MAX_BACKOFF_SECONDS=900

# Cabecalhos de seguranca: HSTS apenas em producao e quando a requisicao chega
# por HTTPS (atras de proxy confiavel). Em dev fica desligado na pratica.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# E-mail transacional via SMTP local (Mailpit). Sem autenticacao/segredos.
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_FROM=no-reply@forja.local

# Aprovacao de empresas (admin de plataforma). Em producao injetar via secrets.
ADMIN_API_KEY=dev_admin_api_key_change_in_production

# Senha dos usuarios de demonstracao do seed (Fase 9A). E usada APENAS para
# criar os usuarios das empresas ficticias de demonstracao (e habilitar login
# da empresa-exemplo). Sem esta variavel, o seed NAO cria usuarios demo.
# Valor abaixo e FICTICIO e so serve para o ambiente local de demonstracao.
# NUNCA reutilize em producao nem versione um valor real (segredos no .env).
DEMO_USER_PASSWORD=DemoLocal@2026

# ============================================================================
# Agentes de IA (Fase 12): chat no app + recuperacao de carrinho abandonado.
# ============================================================================
# AI_AGENTS_ENABLED e o KILL SWITCH GERAL: false (padrao) desliga todos os
# endpoints e jobs de IA (endpoints respondem 503, jobs nao fazem nada) e o
# comportamento do sistema fica identico ao de antes. Somente o BACKEND le
# essas variaveis; a chave do LLM NUNCA vai para o frontend, logs ou respostas.
AI_AGENTS_ENABLED=false
# LLM via API COMPATIVEL com OpenAI (OpenAI, gateways, modelos locais com
# endpoint OpenAI-like). Valores abaixo sao PLACEHOLDERS: configure os reais
# via secrets de producao, nunca no repositorio.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Timeout (segundos) e limite de tokens de cada chamada ao LLM.
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=512
# Orcamento diario de tokens estimados por processo (0 = sem orcamento).
AI_DAILY_TOKEN_BUDGET=200000
# Chat: tamanho maximo da mensagem do usuario e rodadas de historico enviadas.
# O historico nunca inclui precos, CNPJ, e-mail, telefone ou dados de contrato.
AI_CHAT_MAX_MESSAGE_CHARS=500
AI_CHAT_HISTORY_TURNS=10
# Retencao (dias) da conversa do chat para auditoria.
AI_CONVERSATION_TTL_DAYS=30
# Limpeza diaria do chat: lote de conversas expiradas removidas por execucao.
AI_CHAT_CLEANUP_BATCH=500

# ============================================================================
# Canais de notificacao (Fase 3): e-mail transacional e WhatsApp.
# ============================================================================
# Provedor de e-mail: "smtp" (Mailpit local, padrao em dev) ou "resend" (API
# HTTP). A chave e o remetente ficam SOMENTE no backend e NUNCA sao
# versionados. Valores abaixo sao PLACEHOLDERS; configure os reais no .env
# local/secrets. Ex.: RESEND_FROM="Forja <no-reply@seudominio.com>" (o
# endereco/dominio precisa estar VERIFICADO no Resend para enviar).
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=
# WhatsApp (recuperacao de carrinho). DESLIGADO por padrao: so envia com
# WHATSAPP_ENABLED=true E numero E.164 valido E opt-in explicito do usuario.
# Credenciais Z-API ficam SOMENTE no backend, nunca versionadas.
WHATSAPP_ENABLED=false
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

